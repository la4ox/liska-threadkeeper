{
  "name": "liska-threadkeeper",
  "version": "3.0.0",
  "description": "Local-first Chrome extension to bring Gemini, Claude, ChatGPT, Perplexity, DeepSeek, and Gemini Notebook threads home as Markdown",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-service-worker-runtime.mjs",
    "build:zip": "npm run build && node scripts/package-extension.mjs",
    "lint": "eslint src/ && node scripts/lint-platforms.mjs",
    "lint:platforms": "node scripts/lint-platforms.mjs",
    "compare-build": "node scripts/compare-build.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html,json}\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{md,js,mjs,ts,json}\" \"docs/**/*.{md,html}\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html,json}\" \"test/**/*.ts\" \"scripts/**/*.mjs\" \"*.{md,js,mjs,ts,json}\" \"docs/**/*.{md,html}\" \".github/**/*.yml\"",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "mdast-util-from-markdown": "2.1.0",
    "turndown": "^7.1.2"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@nielspeter/ts-archunit": "^0.10.0",
    "@types/chrome": "^0.0.268",
    "@types/jsdom": "^27.0.0",
    "@types/turndown": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.13.0",
    "globals": "^17.4.0",
    "jsdom": "^27.4.0",
    "prettier": "^3.2.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    },
    "undici": "^7.30.1"
  },
  "author": "la4ox",
  "homepage": "https://github.com/la4ox/liska-threadkeeper",
  "repository": {
    "type": "git",
    "url": "https://github.com/la4ox/liska-threadkeeper.git"
  },
  "license": "MIT"
}
